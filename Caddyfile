# Serves the built app (dist/) on Railway. Railway sets PORT and terminates
# HTTPS in front of this server, so Caddy only speaks plain HTTP here.
{
	admin off
	auto_https off
}

:{$PORT} {
	root * /srv
	encode zstd gzip

	# Same security headers as the Base44-hosted storywall.io (checked
	# 2026-10-13), so nothing gets weaker with the move.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(self), usb=(self), magnetometer=(), gyroscope=()"
		# Content-Security-Policy (2026-10-16): only our own scripts run (no
		# inline or third-party scripts), so an injected <script> or event
		# handler can't execute. Styles: ours + Google Fonts (inline styles
		# are needed by React/Framer Motion). Pictures, video and audio may
		# come from any https host (user content, link favicons). Network
		# calls: our origin, https (Supabase API/storage, Google Fonts, image
		# fetches for card export) and Supabase realtime over wss. Tested with
		# the built app on landing, sign-in, walls and the builder: no
		# violations. If something new is blocked, the browser console says
		# which directive to extend.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https: wss://*.supabase.co; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		-Server
	}

	# www.storywall.io sends visitors to storywall.io, as Base44 did, so
	# every link and sign-in lives on one address (sign-in sessions are kept
	# per address). 308 keeps the method and is cached by browsers. The
	# path and query are kept, so www.storywall.io/leo lands on /leo.
	@www host www.storywall.io
	redir @www https://storywall.io{uri} 308

	# Build files have a content hash in their name, so they can be cached
	# for good; a missing one is a real 404, not the app page.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else: a real file from public/ if it exists, otherwise the
	# app itself, which handles routes like /signin and /<username>. Never
	# cached, so a new deploy shows up on the next load.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
