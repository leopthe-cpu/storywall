{
  "name": "Post",
  "properties": {
    "ai_generated": {
      "default": false,
      "description": "Whether this story was generated by the AI carousel builder",
      "type": "boolean"
    },
    "author_id": {
      "type": "string"
    },
    "author_username": {
      "type": "string"
    },
    "cards": {
      "description": "Ordered array of cards",
      "items": {
        "additionalProperties": true,
        "properties": {
          "backgroundImageId": {
            "description": "Element id of the single background (fit-to-card) image/video on this card",
            "type": "string"
          },
          "background_color": {
            "default": "#000000",
            "type": "string"
          },
          "background_token": {
            "description": "Token id referencing a color in the story's color_tokens array",
            "type": "string"
          },
          "elements": {
            "description": "Text, image, video and audio elements on the card",
            "items": {
              "additionalProperties": true,
              "properties": {
                "ai_generated": {
                  "description": "True if this image was AI-generated by Wan (for re-edit mode)",
                  "type": "boolean"
                },
                "borderRadius": {
                  "description": "Corner radius in reference px (image/video)",
                  "type": "number"
                },
                "clipBottom": {
                  "default": 0,
                  "description": "Crop offset from the bottom edge in reference px (crop only)",
                  "type": "number"
                },
                "clipLeft": {
                  "default": 0,
                  "description": "Crop offset from the left edge in reference px (crop only)",
                  "type": "number"
                },
                "clipRight": {
                  "default": 0,
                  "description": "Crop offset from the right edge in reference px (crop only)",
                  "type": "number"
                },
                "clipTop": {
                  "default": 0,
                  "description": "Crop offset from the top edge in reference px (crop only)",
                  "type": "number"
                },
                "color": {
                  "type": "string"
                },
                "color_token": {
                  "description": "Token id referencing a color in the story's color_tokens array",
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "crop_ratio": {
                  "type": "string"
                },
                "displayHeight": {
                  "description": "Rendered height in reference px (resize only)",
                  "type": "number"
                },
                "displayWidth": {
                  "description": "Rendered width in reference px (resize only)",
                  "type": "number"
                },
                "duration": {
                  "description": "Duration in seconds for video/audio elements",
                  "type": "number"
                },
                "flipH": {
                  "description": "Mirror horizontally (image/video)",
                  "type": "boolean"
                },
                "flipV": {
                  "description": "Mirror vertically (image/video)",
                  "type": "boolean"
                },
                "focalX": {
                  "description": "Horizontal focal point / pan within the frame, 0-100 (CSS object-position %), default 50",
                  "type": "number"
                },
                "focalY": {
                  "description": "Vertical focal point / pan within the frame, 0-100 (CSS object-position %), default 50",
                  "type": "number"
                },
                "font_family": {
                  "type": "string"
                },
                "font_italic": {
                  "type": "boolean"
                },
                "font_size": {
                  "type": "string"
                },
                "font_size_estimated": {
                  "description": "Text: true once the one-time content-aware auto-size has run",
                  "type": "boolean"
                },
                "font_size_locked": {
                  "description": "Text: true once manually created or edited \u2014 never auto-resize again",
                  "type": "boolean"
                },
                "font_strikethrough": {
                  "type": "boolean"
                },
                "font_underline": {
                  "type": "boolean"
                },
                "font_weight": {
                  "type": "string"
                },
                "height": {
                  "description": "Legacy: height as % of card (pre-displayHeight elements)",
                  "type": "number"
                },
                "id": {
                  "type": "string"
                },
                "image_url": {
                  "description": "URL of the image, video or audio source",
                  "type": "string"
                },
                "isPannable": {
                  "description": "Set once when Fit to card is applied \u2014 false for 1:1 backgrounds (panning disabled)",
                  "type": "boolean"
                },
                "media_type": {
                  "enum": [
                    "image",
                    "video",
                    "audio"
                  ],
                  "type": "string"
                },
                "naturalHeight": {
                  "description": "Intrinsic height of the source image/video, set once on load",
                  "type": "number"
                },
                "naturalWidth": {
                  "description": "Intrinsic width of the source image/video, set once on load",
                  "type": "number"
                },
                "overlay_color": {
                  "type": "string"
                },
                "overlay_intensity": {
                  "type": "number"
                },
                "overlay_position": {
                  "type": "string"
                },
                "overlay_type": {
                  "type": "string"
                },
                "panX": {
                  "description": "Background pan offset from center in reference px",
                  "type": "number"
                },
                "panY": {
                  "description": "Background pan offset from center in reference px",
                  "type": "number"
                },
                "preBackgroundState": {
                  "description": "Snapshot used to revert a background image to its prior regular state",
                  "type": "object"
                },
                "rotation": {
                  "description": "Rotation in degrees (image/video)",
                  "type": "number"
                },
                "text_align": {
                  "default": "left",
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ],
                  "type": "string"
                },
                "text_fx_echo_color": {
                  "type": "string"
                },
                "text_fx_echo_intensity": {
                  "description": "Text FX echo strength 0-100 (0 = off)",
                  "type": "number"
                },
                "text_fx_glow_color": {
                  "type": "string"
                },
                "text_fx_glow_intensity": {
                  "description": "Text FX glow strength 0-100 (0 = off)",
                  "type": "number"
                },
                "text_fx_outline_color": {
                  "type": "string"
                },
                "text_fx_outline_intensity": {
                  "description": "Text FX outline strength 0-100 (0 = off)",
                  "type": "number"
                },
                "text_fx_shadow_color": {
                  "type": "string"
                },
                "text_fx_shadow_intensity": {
                  "description": "Text FX shadow strength 0-100 (0 = off)",
                  "type": "number"
                },
                "text_fx_spacing": {
                  "description": "Text FX letter spacing -100..100 (0 = off, negative = tighter)",
                  "type": "number"
                },
                "text_transform": {
                  "description": "Text: CSS text-transform (e.g. uppercase)",
                  "type": "string"
                },
                "text_type": {
                  "enum": [
                    "header",
                    "subheader",
                    "body"
                  ],
                  "type": "string"
                },
                "text_warp": {
                  "description": "Text warp (doc 108 Phase 2): arc | wave | stairs | bulge | none",
                  "type": "string"
                },
                "text_warp_amount": {
                  "description": "Text warp strength -100..100 (0 = off; sign flips direction)",
                  "type": "number"
                },
                "trimEnd": {
                  "description": "Non-destructive playback end point in seconds (audio/video). 0 = full duration",
                  "type": "number"
                },
                "trimStart": {
                  "description": "Non-destructive playback start point in seconds (audio/video)",
                  "type": "number"
                },
                "type": {
                  "enum": [
                    "text",
                    "image",
                    "video",
                    "audio"
                  ],
                  "type": "string"
                },
                "width": {
                  "description": "Legacy: width as % of card (pre-displayWidth elements)",
                  "type": "number"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z_index": {
                  "type": "number"
                },
                "zoom": {
                  "description": "Zoom percentage for non-background image/video (50-200)",
                  "type": "number"
                },
                "zoomLevel": {
                  "description": "Uniform zoom factor for background (fit-to-card) image/video (>=1.0)",
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "imageGenerationFailed": {
            "description": "AI image generation failed for this card \u2014 shows Retry",
            "type": "boolean"
          },
          "imagePrompt": {
            "description": "AI image prompt for this card (used by Retry image generation)",
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "photoTreatment": {
            "description": "AI style photo treatment (e.g. inset)",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "color_tokens": {
      "description": "Named color tokens shared across all cards in this story. Elements reference tokens by id instead of storing hardcoded colors.",
      "items": {
        "properties": {
          "color": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "color"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "cover_image": {
      "type": "string"
    },
    "display_order": {
      "description": "Manual ordering of stories on the profile (ascending). Absent = fall back to created_date desc",
      "type": "number"
    },
    "generation_style": {
      "description": "Style template ID used for AI generation (for re-edit mode)",
      "type": "string"
    },
    "raw_notes": {
      "description": "Free-text notes used as input for AI carousel generation",
      "type": "string"
    },
    "skill_refresh_count": {
      "default": 0,
      "description": "Number of skill-suggestion refreshes used today",
      "type": "number"
    },
    "skill_refresh_date": {
      "description": "ISO date (YYYY-MM-DD) of the last skill-suggestion refresh \u2014 used to reset the daily cap",
      "type": "string"
    },
    "status": {
      "default": "published",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "author_id"
  ],
  "rls": {
    "create": {
      "data.author_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "$and": [
            {
              "data.status": {
                "$in": [
                  "draft",
                  "archived"
                ]
              }
            },
            {
              "data.author_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}