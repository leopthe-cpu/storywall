{
  "name": "Media",
  "properties": {
    "duration": {
      "description": "Duration in seconds for video/audio",
      "type": "number"
    },
    "image_url": {
      "description": "URL of the image, video or audio file",
      "type": "string"
    },
    "media_type": {
      "default": "image",
      "enum": [
        "image",
        "video",
        "audio"
      ],
      "type": "string"
    },
    "user_id": {
      "description": "Owner user id",
      "type": "string"
    }
  },
  "required": [
    "image_url",
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}
