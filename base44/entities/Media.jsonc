{
  "name": "Media",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string",
      "description": "URL of the image, video or audio file"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "audio"
      ],
      "default": "image"
    },
    "duration": {
      "type": "number",
      "description": "Duration in seconds for video/audio"
    },
    "user_id": {
      "type": "string",
      "description": "Owner user id"
    }
  },
  "required": [
    "image_url",
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}