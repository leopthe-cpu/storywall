{
  "name": "Follow",
  "type": "object",
  "properties": {
    "follower_id": {
      "type": "string",
      "description": "User ID of the follower"
    },
    "follower_email": {
      "type": "string"
    },
    "following_id": {
      "type": "string",
      "description": "User ID being followed"
    },
    "following_email": {
      "type": "string"
    }
  },
  "required": [
    "follower_id",
    "following_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.follower_id": "{{user.id}}"
        },
        {
          "data.follower_email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.follower_id": "{{user.id}}"
        },
        {
          "data.following_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.follower_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}