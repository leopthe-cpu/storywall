{
  "type": "object",
  "name": "PremiumGrant",
  "title": "PremiumGrant",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the User granted premium access. Only admins can create, edit or delete grants."
    },
    "note": {
      "type": "string",
      "description": "Optional admin note (why/when access was granted)"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}